#===============================================================================
# Varashta Djinn Commander Sorceress - LOOT FILTER for Path of Exile 2 (generated by WraeclastArchitect)
# Forbidden Rites, patch 0.5.5, verified 2026-11-26
# Install: save as VarashtaDjinnCommanderSorceress.filter in Documents/My Games/Path of Exile 2/
#          then pick it in Options > UI > Item Filter.
# Class and BaseType names were checked against a working PoE 2 filter and the PoE 2 game data.
# Not loaded in the game by the generator. Unknown item types are SHOWN, never hidden.
# Area level 65 and up is treated as Waystone maps; item level 82 is the 'top item' line.
#===============================================================================
# ---- GOLD
Show # big gold pile
	StackSize >= 2000
	BaseType == "Gold"
	SetFontSize 38
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 20 20 0 255
	PlayEffect Orange
Show # gold
	BaseType == "Gold"
	SetFontSize 30
	SetTextColor 200 170 60 255
# ---- UNCUT GEMS (matched by gem level; the level is the level the gem will be cut at)
Show # Uncut Skill Gem level 18+
	GemLevel >= 18
	BaseType == "Uncut Skill Gem"
	SetFontSize 45
	SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
	PlayAlertSound 6 300
	PlayEffect Red
	MinimapIcon 0 Red Star
Show # Uncut Spirit Gem level 18+
	GemLevel >= 18
	BaseType == "Uncut Spirit Gem"
	SetFontSize 45
	SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
	PlayAlertSound 6 300
	PlayEffect Red
	MinimapIcon 0 Red Star
