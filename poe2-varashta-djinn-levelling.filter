# ---- BUILD GEMS (cut skill and support gems the build uses)
Show # gems this build uses
	Class == "Skill Gems" "Support Gems"
	BaseType == "Spark" "Contagion" "Frost Bomb" "Essence Drain" "Chain I" "Swift Affliction I" "Bonestorm" "Zenith I" "Concentrated Area" "Living Lightning" "Arctic Armour" "Kelari, the Tainted Sands" "Bidding I" "Blindside" "Ruzhan, the Blazing Sword" "Pain Offering" "Muster"
	SetFontSize 45
	SetTextColor 0 0 0 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 0 220 220 255
	PlayAlertSound 6 300
	PlayEffect Cyan
	MinimapIcon 0 Cyan Star
Show # other gems
	Class == "Skill Gems" "Support Gems"
	SetFontSize 34
	SetTextColor 0 240 240 255
	SetBorderColor 0 240 240 255
	SetBackgroundColor 10 30 40 255
