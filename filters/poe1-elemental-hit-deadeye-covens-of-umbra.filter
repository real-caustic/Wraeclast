#===============================================================================
# Elemental Hit Deadeye - LOOT FILTER (generated by WraeclastArchitect)
# Covens of Umbra league, patch 3.30, verified 2026-11-20
# Install: save as ElementalHitDeadeye.filter in Documents/My Games/Path of Exile/
#          then pick it in Options > UI > Item Filter.
# Gear the build does not use (other classes, other bases) is hidden. Normal items are hidden unless the
# build needs them. Unknown item types and new league items are SHOWN, never hidden.
#===============================================================================


#------------------------------------------------------------------------------
# 1. CURRENCY (critical = loud, every upgrade currency highlighted)
#    Names are from earlier patches; anything renamed or new falls into the grey catch-all.
#------------------------------------------------------------------------------
Show # Top tier
    Class "Stackable Currency"
    BaseType == "Mirror of Kalandra" "Divine Orb" "Exalted Orb" "Orb of Annulment" "Mirror Shard"
    SetFontSize 45
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 200 0 0 255
    PlayAlertSound 6 300
    PlayEffect Red
    MinimapIcon 0 Red Star

Show # Chaos
    Class "Stackable Currency"
    BaseType == "Chaos Orb"
    SetFontSize 42
    SetTextColor 0 0 0
    SetBorderColor 0 0 0
    SetBackgroundColor 255 150 0 255
    PlayAlertSound 2 250
    PlayEffect Orange
    MinimapIcon 0 Orange Circle

Show # Core upgrade currency: links, sockets, colours, rarity, gem quality, corruption, rerolls
    Class "Stackable Currency"
    BaseType == "Vaal Orb" "Gemcutter's Prism" "Orb of Fusing" "Jeweller's Orb" "Chromatic Orb" "Regal Orb" "Orb of Scouring" "Orb of Regret" "Orb of Alchemy" "Orb of Alteration" "Orb of Chance" "Blessed Orb" "Orb of Transmutation" "Orb of Augmentation" "Ancient Orb" "Orb of Binding" "Orb of Horizons" "Orb of Unmaking" "Orb of Conflict" "Awakener's Orb" "Orb of Dominance" "Fracturing Orb"
    SetFontSize 40
    SetTextColor 0 0 0
    SetBorderColor 0 0 0
    SetBackgroundColor 255 255 120 255
    PlayAlertSound 3 220
    PlayEffect Yellow
    MinimapIcon 1 Yellow Circle

Show # Quality currency
    Class "Stackable Currency"
    BaseType == "Blacksmith's Whetstone" "Armourer's Scrap" "Glassblower's Bauble" "Cartographer's Chisel"
    SetFontSize 36
    SetTextColor 0 0 0
    SetBorderColor 0 0 0
    SetBackgroundColor 255 220 120 255
    PlayAlertSound 3 150
    PlayEffect Yellow Temp
    MinimapIcon 2 Yellow Circle

Show # Crafting families
    Class "Stackable Currency"
    BaseType "Essence of" "Catalyst" "Fossil" "Resonator" "Eldritch Ember" "Eldritch Ichor" "Deafening Essence" "Remnant of Corruption" "Tainted"
    SetFontSize 36
    SetTextColor 0 0 0
    SetBorderColor 0 0 0
    SetBackgroundColor 255 200 80 255
    PlayAlertSound 3 130
    MinimapIcon 2 Orange Circle

Show # Leveling essentials
    Class "Stackable Currency"
    BaseType == "Scroll of Wisdom" "Portal Scroll"
    SetFontSize 34
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 0 0 0 220

Show # Any other currency, including new league currency
    Class "Stackable Currency" "Currency"
    SetFontSize 34
    SetTextColor 255 255 255
    SetBorderColor 200 200 200
    SetBackgroundColor 40 40 40 220
    PlayAlertSound 4 150

Show # Quest items and Labyrinth items are never hidden
    Class "Quest Items" "Labyrinth" "Pantheon Soul"
    SetFontSize 40
    SetTextColor 74 230 58
    SetBorderColor 74 230 58
    SetBackgroundColor 0 0 0 220
    PlayAlertSound 5 200


#------------------------------------------------------------------------------
# 3. UNIQUES: Goldrim, Tabula Rasa, Wanderlust, Prismweave, Daresso's Defiance, Hyrri's Ire
#------------------------------------------------------------------------------

Show # Build uniques by base type
    Rarity Unique
    BaseType == "Leather Cap" "Simple Robe" "Wool Shoes" "Rustic Sash" "Full Dragonscale" "Zodiac Leather" "Sharktooth Arrow Quiver"
    SetFontSize 45
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 175 96 37 255
    PlayAlertSound 6 300
    PlayEffect Brown
    MinimapIcon 0 Brown Star

Hide # Uniques of weapon and gear classes the build never uses (set loot_filter.show_all_uniques to show them)
    Rarity Unique
    Class "Body Armours" "Shields" "Wands" "Daggers" "Sceptres" "Axes" "Maces" "Swords" "Staves" "Claws" "Rune Daggers" "Warstaves" "Thrusting"
    SetFontSize 28

Show # All other uniques
    Rarity Unique
    SetFontSize 38
    SetTextColor 175 96 37
    SetBorderColor 175 96 37
    SetBackgroundColor 0 0 0 255
    PlayAlertSound 3 200
    PlayEffect Brown
    MinimapIcon 1 Brown Square

#------------------------------------------------------------------------------
# 4. BUILD GEMS (BaseType matches by substring, so 'Spell Totem' covers 'Spell Totem Support')
#------------------------------------------------------------------------------

Show # BUILD GEMS, main skill and its links: biggest text, white border, loud sound (alert 8), cyan beam, large star on the minimap
    Class "Skill Gems" "Support Gems"
    BaseType "Galvanic Arrow" "Mirage Archer Support" "Added Cold Damage Support" "Rain of Arrows" "Elemental Damage with Attacks Support" "Faster Attacks Support" "Elemental Hit" "Trinity Support" "Returning Projectiles Support"
    SetFontSize 45
    SetTextColor 0 0 0
    SetBorderColor 255 255 255
    SetBackgroundColor 0 230 255 255
    PlayAlertSound 8 300
    PlayEffect Cyan
    MinimapIcon 0 Cyan Star

Show # BUILD GEMS, every other gem the build uses: same size, loud sound (alert 10), cyan beam, large hexagon on the minimap
    Class "Skill Gems" "Support Gems"
    BaseType "Shrapnel Ballista" "Artillery Ballista" "Focused Ballista Support" "Inspiration Support" "Immolate Support" "Haste" "Herald of Ice" "Precision" "Sniper's Mark" "Mark On Hit Support" "Lifetap Support" "Blink Arrow" "Frostblink" "Manaforged Arrows Support" "Frenzy" "Ensnaring Arrow" "Immortal Call" "Cast when Damage Taken Support" "Lightning Arrow"
    SetFontSize 45
    SetTextColor 0 0 0
    SetBorderColor 255 255 255
    SetBackgroundColor 27 162 155 255
    PlayAlertSound 10 300
    PlayEffect Cyan
    MinimapIcon 0 Cyan Hexagon

Show # Quality gems (Gemcutter vendor recipe)
    Class "Skill Gems" "Support Gems"
    Quality >= 10
    SetFontSize 32
    SetTextColor 27 162 155
    SetBorderColor 27 162 155
    SetBackgroundColor 0 0 0 220

Hide # All other gems
    Class "Skill Gems" "Support Gems"
    SetFontSize 30

Hide # Bases only used while leveling, hidden above area level 67
    Rarity <= Rare
    BaseType == "Royal Bow"
    AreaLevel > 67
    SetFontSize 28

#------------------------------------------------------------------------------
# 5. BUILD GEAR
#------------------------------------------------------------------------------

Show # Searing Exarch implicit, tier 3+ (1 Lesser to 6 Perfect), on the named bases of the slots that use Eldritch implicits
    Class "Boots"
    BaseType == "Royal Bow" "Onyx Amulet" "Two-Stone Ring" "Imperial Bow" "Feathered Arrow Quiver" "Leather Belt" "Heavy Belt"
    HasSearingExarchImplicit >= 3
    Rarity <= Rare
    SetFontSize 42
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 120 20 20 255
    PlayAlertSound 2 300
    PlayEffect White
    MinimapIcon 0 White Diamond

Show # Eater of Worlds implicit, tier 3+ (1 Lesser to 6 Perfect), on the named bases of the slots that use Eldritch implicits
    Class "Boots"
    BaseType == "Royal Bow" "Onyx Amulet" "Two-Stone Ring" "Imperial Bow" "Feathered Arrow Quiver" "Leather Belt" "Heavy Belt"
    HasEaterOfWorldsImplicit >= 3
    Rarity <= Rare
    SetFontSize 42
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 20 60 130 255
    PlayAlertSound 2 300
    PlayEffect White
    MinimapIcon 0 White Diamond

Show # Top item level (84+) on the bases the build names
    Rarity Rare
    BaseType == "Royal Bow" "Onyx Amulet" "Two-Stone Ring" "Imperial Bow" "Feathered Arrow Quiver" "Leather Belt" "Heavy Belt"
    ItemLevel >= 84
    SetFontSize 45
    SetTextColor 0 0 0
    SetBorderColor 255 255 255
    SetBackgroundColor 255 215 0 255
    PlayAlertSound 2 300
    PlayEffect White
    MinimapIcon 0 White Star

Show # Top item level (84+), armour slots
    Rarity Rare
    Class "Helmets" "Gloves" "Boots"
    ItemLevel >= 84
    SetFontSize 45
    SetTextColor 0 0 0
    SetBorderColor 255 255 255
    SetBackgroundColor 255 215 0 255
    PlayAlertSound 2 300
    PlayEffect White
    MinimapIcon 0 White Star

Show # Top item level (84+), other slots the build uses
    Rarity Rare
    Class "Belts" "Bows" "Quivers"
    ItemLevel >= 84
    SetFontSize 45
    SetTextColor 0 0 0
    SetBorderColor 255 255 255
    SetBackgroundColor 255 215 0 255
    PlayAlertSound 2 300
    PlayEffect White
    MinimapIcon 0 White Star

Show # Bases the build gears into (rare or magic, item level 60+)
    Rarity <= Rare
    BaseType == "Royal Bow" "Onyx Amulet" "Two-Stone Ring" "Imperial Bow" "Feathered Arrow Quiver" "Leather Belt" "Heavy Belt"
    ItemLevel >= 60
    SetFontSize 40
    SetTextColor 255 255 119
    SetBorderColor 255 255 119
    SetBackgroundColor 40 40 0 255
    PlayAlertSound 2 220
    PlayEffect Yellow
    MinimapIcon 1 Yellow Hexagon

Show # Named bases at any item level (magic or rare)
    Rarity >= Magic
    Rarity <= Rare
    BaseType == "Royal Bow" "Onyx Amulet" "Two-Stone Ring" "Imperial Bow" "Feathered Arrow Quiver" "Leather Belt" "Heavy Belt"
    SetFontSize 36
    SetTextColor 255 255 119
    SetBorderColor 255 255 119
    SetBackgroundColor 20 20 0 255
    PlayAlertSound 2 150

Show # Rare Bows: usually the biggest damage slot
    Class "Bows"
    Rarity Rare
    SetFontSize 40
    SetTextColor 255 255 119
    SetBorderColor 255 255 119
    SetBackgroundColor 40 40 0 255
    PlayAlertSound 2 200
    PlayEffect Yellow
    MinimapIcon 1 Yellow Triangle

Show # Magic Bows for leveling
    Class "Bows"
    Rarity Magic
    SetFontSize 36
    SetTextColor 136 136 255
    SetBorderColor 136 136 255
    SetBackgroundColor 0 0 40 255

#------------------------------------------------------------------------------
# 7. NORMAL ITEMS THE BUILD CAN USE WHILE LEVELING
#------------------------------------------------------------------------------

Show # Normal bows with 4 sockets, all linked, while leveling: loud sound and green beam
    Rarity Normal
    Sockets 4
    LinkedSockets 4
    Class "Bows"
    AreaLevel <= 67
    SetFontSize 42
    SetTextColor 0 0 0
    SetBorderColor 0 0 0
    SetBackgroundColor 120 230 120 255
    PlayAlertSound 7 300
    PlayEffect Green
    MinimapIcon 0 Green Circle

Show # Normal bows with 4 links while leveling
    Rarity Normal
    LinkedSockets 4
    Class "Bows"
    AreaLevel <= 67
    SetFontSize 34
    SetTextColor 255 255 255
    SetBorderColor 200 200 200
    SetBackgroundColor 60 0 60 255

Show # Flasks the build uses
    Class "Utility Flasks" "Life Flasks" "Mana Flasks" "Hybrid Flasks"
    BaseType "Divine Life Flask" "Quicksilver Flask" "Silver Flask" "Jade Flask" "Eternal Mana Flask"
    SetFontSize 32
    SetTextColor 200 200 200
    SetBorderColor 200 200 200
    SetBackgroundColor 0 0 0 220

#------------------------------------------------------------------------------
# 7b. HIDE GEAR THE BUILD DOES NOT USE. Open classes (any base is fine): Helmets, Gloves, Boots, Belts, Rings, Amulets, Bows, Quivers.
#     Every other class only shows the base types the build names. Uniques were already shown above.
#------------------------------------------------------------------------------

Hide # Magic and rare amulets, rings that are not the bases the build names (area level above 67)
    Rarity <= Rare
    Class "Amulets" "Rings"
    AreaLevel > 67
    SetFontSize 28

Hide # Magic and rare items of classes and bases the build does not use
    Rarity >= Magic
    Rarity <= Rare
    Class "Body Armours" "Shields" "Wands" "Daggers" "Sceptres" "Axes" "Maces" "Swords" "Staves" "Claws" "Rune Daggers" "Warstaves" "Thrusting" "Jewel"
    SetFontSize 28

Hide # Normal items of those classes
    Rarity Normal
    Class "Body Armours" "Shields" "Wands" "Daggers" "Sceptres" "Axes" "Maces" "Swords" "Staves" "Claws" "Rune Daggers" "Warstaves" "Thrusting" "Jewel"
    SetFontSize 28

#------------------------------------------------------------------------------
# 6. SOCKETS AND LINKS
#------------------------------------------------------------------------------
Show # 6 links
    LinkedSockets 6
    SetFontSize 45
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 255 0 255 255
    PlayAlertSound 6 300
    PlayEffect Pink
    MinimapIcon 0 Pink Star

Show # 5 links
    LinkedSockets 5
    SetFontSize 40
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 160 0 160 255
    PlayAlertSound 3 220
    PlayEffect Pink
    MinimapIcon 1 Pink Diamond

Show # 6 sockets that are not all linked: pink beam and marker, no sound
    Sockets 6
    SetFontSize 38
    SetTextColor 255 255 255
    SetBorderColor 255 255 255
    SetBackgroundColor 100 0 100 255
    PlayEffect Pink
    MinimapIcon 2 Pink Circle

Show # 4 sockets, all linked: loud sound, green beam and green minimap marker
    Sockets 4
    LinkedSockets 4
    SetFontSize 42
    SetTextColor 0 0 0
    SetBorderColor 0 0 0
    SetBackgroundColor 120 230 120 255
    PlayAlertSound 7 300
    PlayEffect Green
    MinimapIcon 0 Green Circle

Show # 4 or more sockets that are not all linked: green beam and marker, no sound
    Sockets >= 4
    SetFontSize 36
    SetTextColor 0 0 0
    SetBorderColor 0 0 0
    SetBackgroundColor 120 230 120 255
    PlayEffect Green
    MinimapIcon 2 Green Circle


#------------------------------------------------------------------------------
# 8. CHAOS RECIPE (optional): unidentified rares of item level 60+ (check the vendor tooltip for the current recipe)
#------------------------------------------------------------------------------

# Chaos recipe highlight is off (it needs every base). Set loot_filter.chaos_recipe to true to add it.


#------------------------------------------------------------------------------
# 9. MAGIC AND RARE ITEMS OF THE CLASSES THE BUILD USES (any base only where the build names none; set loot_filter.show_vendor_gear to show every class)
#------------------------------------------------------------------------------

Show # Rare (classes the build uses with any base)
    Rarity Rare
    Class "Helmets" "Gloves" "Boots" "Belts" "Bows" "Quivers"
    SetFontSize 34
    SetTextColor 255 255 119
    SetBorderColor 255 255 119
    SetBackgroundColor 0 0 0 220

Show # Rare while leveling (area level 67 or lower)
    Rarity Rare
    Class "Rings" "Amulets"
    AreaLevel <= 67
    SetFontSize 34
    SetTextColor 255 255 119
    SetBorderColor 255 255 119
    SetBackgroundColor 0 0 0 220

Show # Magic (classes the build uses with any base)
    Rarity Magic
    Class "Helmets" "Gloves" "Boots" "Belts" "Bows" "Quivers"
    SetFontSize 32
    SetTextColor 136 136 255
    SetBorderColor 136 136 255
    SetBackgroundColor 0 0 0 200

Show # Magic while leveling (area level 67 or lower)
    Rarity Magic
    Class "Rings" "Amulets"
    AreaLevel <= 67
    SetFontSize 32
    SetTextColor 136 136 255
    SetBorderColor 136 136 255
    SetBackgroundColor 0 0 0 200

#------------------------------------------------------------------------------
# 10. HIDE COMMON (NORMAL) ITEMS. Only these classes are hidden; unknown item types stay visible.
#------------------------------------------------------------------------------

Hide # Normal equipment, flasks, jewels, cards and maps
    Rarity Normal
    Class "Helmets" "Body Armours" "Gloves" "Boots" "Belts" "Rings" "Amulets" "Shields" "Wands" "Daggers" "Sceptres" "Axes" "Maces" "Swords" "Bows" "Staves" "Claws" "Rune Daggers" "Warstaves" "Thrusting" "Quivers" "Flasks" "Jewel" "Divination Card" "Maps"
    SetFontSize 28

# End of filter.
