#------------------------------------------------------------------------------

Show # Rare (classes the build uses with any base)
    Rarity Rare
    Class "Helmets" "Gloves" "Boots" "Shields" "Wands"
    SetFontSize 34
    SetTextColor 255 255 119
    SetBorderColor 255 255 119
    SetBackgroundColor 0 0 0 220

