    Rarity Rare
    Class "Body Armours" "Belts" "Rings" "Amulets"
    AreaLevel <= 67
    SetFontSize 34
    SetTextColor 255 255 119
    SetBorderColor 255 255 119
    SetBackgroundColor 0 0 0 220

Show # Magic (classes the build uses with any base)
    Rarity Magic
    Class "Helmets" "Gloves" "Boots" "Shields" "Wands"
    SetFontSize 32
    SetTextColor 136 136 255
    SetBorderColor 136 136 255
    SetBackgroundColor 0 0 0 200

Show # Magic while leveling (area level 67 or lower)
    Rarity Magic
    Class "Body Armours" "Belts" "Rings" "Amulets"
    AreaLevel <= 67
    SetFontSize 32
    SetTextColor 136 136 255
    SetBorderColor 136 136 255
    SetBackgroundColor 0 0 0 200

#------------------------------------------------------------------------------
# 10. HIDE COMMON (NORMAL) ITEMS. Only these classes are hidden; unknown item types stay visible.
#------------------------------------------------------------------------------

Hide # Normal equipment, flasks, jewels, cards and maps
    Rarity Normal
    Class "Helmets" "Body Armours" "Gloves" "Boots" "Belts" "Rings" "Amulets" "Shields" "Wands" "Daggers" "Sceptres" "Axes" "Maces" "Swords" "Bows" "Staves" "Claws" "Rune Daggers" "Warstaves" "Thrusting" "Quivers" "Flasks" "Jewel" "Divination Card" "Maps"
    SetFontSize 28

# End of filter.
